# InfoGenie platform — Phase 0 environment
#
# Secrets live here (and in a managed secret store in real environments), never
# in source control. `.env` is gitignored; CI scans full history for secrets.

# Application database role — RLS is enforced against this connection. All
# tenant-scoped data access uses it at runtime.
DATABASE_URL=postgres://infogenie_app:app_local_dev_only@127.0.0.1:5433/infogenie

# Privileged role used ONLY for migrations and platform bootstrap — never for
# request-path data access (it would bypass RLS).
ADMIN_DATABASE_URL=postgres://postgres@127.0.0.1:5433/infogenie

# HTTP
PORT=4000
NODE_ENV=development

# Secret used to derive one-way hashes for suppression addresses and tokens.
# Rotate via the secret store; changing it starts a new hash namespace.
HASH_PEPPER=local-dev-pepper-change-me
