# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnpm-store/
.cache/
.upm/

# ── Secrets & env ────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json
google-credentials*.json

# ── Replit local state ───────────────────────────────────────
.local/
.replit.local
.config/
.replit_history
.breakpoints

# ── Runtime data (auto-migrated to Postgres kv_store at boot) ─
data/*.json
!data/.gitkeep

# ── User uploads (user-generated, not source) ────────────────
uploads/**/*
!uploads/.gitkeep
!uploads/**/.gitkeep

# ── Logs & temp ──────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
/tmp/
logs/
*.pid
*.seed

# ── Editor / OS junk ─────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ── Build output (none in current SPA, but future-proof) ─────
dist/
build/
.next/
.nuxt/
out/

# ── Test / coverage ──────────────────────────────────────────
coverage/
.nyc_output/

# ── Root-level scratch / code-extraction note files ──────────
# Throwaway staging copies from past code-extraction efforts (duplicated
# snippets of code that already lives in app.js / index.html / public/js).
# Scoped to the project root (leading /) so legitimate .txt files elsewhere
# (and robots.txt) are unaffected.
/module*.txt
/m[0-9]*.txt
/batch[0-9]*.txt
/views.txt
/views_full.txt
/navigateTo.txt
/navigateTo_full.txt
/disp.txt
/audit_index.txt
