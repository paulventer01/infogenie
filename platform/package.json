{
  "name": "infogenie-platform",
  "version": "0.1.0",
  "private": true,
  "description": "InfoGenie platform — Phase 0 foundations (multi-tenant, governed, auditable)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "migrate": "tsx src/migrate.ts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "express": "^4.21.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.11.10",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.19.0"
  }
}
